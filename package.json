{
  "name": "logseq-on-this-day",
  "version": "0.0.4",
  "type": "module",
  "author": "imrickysu",
  "main": "dist/index.html",
  "description": "Review previous journals on this day.",
  "scripts": {
    "dev": "parcel index.html --port 1235",
    "build": "parcel build --public-url ./ --no-source-maps index.html  --no-minify",
    "lint": "eslint index.js",
    "lint:fix": "eslint index.js --fix",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "logseq": {
    "icon": "./icon.png",
    "id": "logseq-on-this-day"
  },
  "dependencies": {
    "@logseq/libs": "^0.0.17"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "parcel-bundler": "^1.12.5"
  },
  "license": "MIT",
  "browserslist": [
    "chrome 80"
  ]
}
